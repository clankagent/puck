{
  "name": "@clankagent/puck",
  "version": "0.2.0",
  "description": "Frame-independent six-axis input, pan/zoom and tunable gestures",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "llms.txt",
    "examples/camera.mjs",
    "examples/gesture-session.mjs",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "VERIFICATION.md"
  ],
  "exports": {
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhid": {
      "types": "./dist/webhid.d.ts",
      "import": "./dist/webhid.js"
    }
  },
  "scripts": {
    "lab": "node examples/gestures/serve.mjs",
    "lab:analyze": "node examples/gestures/analyze-recording.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run build && pnpm test",
    "prepack": "pnpm run check"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clankagent/puck.git"
  },
  "homepage": "https://github.com/clankagent/puck#readme",
  "bugs": {
    "url": "https://github.com/clankagent/puck/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "spacemouse",
    "webhid",
    "pan",
    "zoom",
    "input"
  ]
}
