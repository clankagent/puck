{
  "name": "@clankagent/puck",
  "version": "2.0.0-alpha.3",
  "description": "Typed physical controls, six-axis motion and gestures for SpaceMouse applications",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "llms.txt",
    "examples/camera.mjs",
    "examples/gesture-session.mjs",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "DESIGN.md",
    "VERIFICATION.md",
    "RELEASING.md",
    "include/puck.h",
    "examples/native/PuckSmoke.kt"
  ],
  "exports": {
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhid": {
      "types": "./dist/webhid.d.ts",
      "import": "./dist/webhid.js"
    }
  },
  "scripts": {
    "site:build": "pnpm build && node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "lab": "node examples/gestures/serve.mjs",
    "lab:analyze": "node examples/gestures/analyze-recording.mjs",
    "build": "node scripts/build-rust.mjs --native && node scripts/build-parity.mjs && tsc -p tsconfig.json && tsc -p tests/reference/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run build && pnpm exec tsc -p tests/types/tsconfig.json && pnpm test",
    "prepack": "pnpm run check",
    "build:native": "node scripts/build-rust.mjs --native",
    "browser:check": "node scripts/browser-check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clankagent/puck.git"
  },
  "homepage": "https://github.com/clankagent/puck#readme",
  "bugs": {
    "url": "https://github.com/clankagent/puck/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "spacemouse",
    "webhid",
    "pan",
    "zoom",
    "input"
  ]
}
